# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use test keys until you're ready to go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Settings → Webhooks (used to verify /api/razorpay/webhook calls)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Delhivery (shipping label generation) ────────────────────────────────
# ucp.delhivery.com → API docs / integration section for your token.
DELHIVERY_API_TOKEN=your-delhivery-api-token
# Exact client/company name as registered on your Delhivery account.
DELHIVERY_CLIENT_NAME=Your Company Name
# Exact pickup/warehouse facility name registered on your Delhivery account.
DELHIVERY_PICKUP_LOCATION=Your Facility Name
DELHIVERY_PICKUP_ADDRESS=Your pickup address, City, State, India PIN
DELHIVERY_PICKUP_CITY=Your City
DELHIVERY_PICKUP_PINCODE=000000
DELHIVERY_PICKUP_PHONE=0000000000
# HSN code for incense sticks/agarbatti (Chapter 33) — override if needed.
DELHIVERY_HSN_CODE=33074100
# Leave blank if not GST-registered; Delhivery may reject shipments without
# one depending on your account tier — contact Delhivery support if so.
DELHIVERY_SELLER_GST_TIN=

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cense.in
